PORT=4000

# Shared with every remote's vite.config.ts guard plugin (packages/asset-token).
# Dev-only fallback exists in code; override this in any real deployment.
ASSET_TOKEN_SECRET=dev-only-shared-secret-change-me

# false for local http dev; MUST be true once served over https, and the
# cookie name below should be renamed with the __Secure- prefix at that point
# (see docs/07-security-architecture.md).
SESSION_COOKIE_SECURE=false

# Origins allowed to call this API with credentials. In production this
# should be the Host origin only (Tier 1) — the extra ports here exist only
# to support this repo's documented "standalone MFE dev" workflow.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
